{
  "name": "@sentinel/shared-schemas",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript types generated from the Sentinel Planner OpenAPI document.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "openapi.json"
  ],
  "scripts": {
    "generate": "openapi-typescript ./openapi.json --output ./src/generated/api.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.5.0",
    "typescript": "^5.7.2"
  }
}
