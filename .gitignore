# --- Geospatial data ---------------------------------------------------------
# Raw uploads and derived products are never committed. Keep the folders only.
data/raw/*
data/processed/*
data/outputs/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/outputs/.gitkeep

