# Copy to .env and adjust. Never commit .env.
# Every API setting is read from the environment with the SENTINEL_ prefix.

# --- Runtime -----------------------------------------------------------------
SENTINEL_ENVIRONMENT=local          # local | ci | staging | production
SENTINEL_LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
SENTINEL_LOG_JSON=false             # true forces JSON logs (default: true unless local)

# --- API ---------------------------------------------------------------------
SENTINEL_API_HOST=0.0.0.0
SENTINEL_API_PORT=8000
SENTINEL_CORS_ORIGINS=http://localhost:3000

# --- Database ----------------------------------------------------------------
# Used by docker compose to initialise the PostGIS container.
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=sentinel
POSTGRES_PORT=5432

# Consumed by the API and by Alembic.
SENTINEL_DATABASE_URL=postgresql+psycopg://sentinel:change-me-locally@localhost:5432/sentinel

# Separate database for the test suite. Create it once with `make db-test-create`.
# Database-backed tests skip themselves when this is unreachable.
SENTINEL_TEST_DATABASE_URL=postgresql+psycopg://sentinel:change-me-locally@localhost:5432/sentinel_test

# --- Storage -----------------------------------------------------------------
# Absolute path preferred. When unset the API resolves <repo root>/data.
# SENTINEL_DATA_DIR=/srv/sentinel/data
SENTINEL_MAX_UPLOAD_MB=512

# --- Frontend ----------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Server-side base URL, used inside docker compose where the API is not localhost.
API_BASE_URL=http://localhost:8000

# --- Published ports (change if something else already uses them) -------------
API_PORT=8000
WEB_PORT=3000
